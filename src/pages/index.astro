---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import About from '../components/About.astro';
import PublicationsSection from '../components/PublicationsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import TalksSection from '../components/TalksSection.astro';
import NewsSection from '../components/NewsSection.astro';
import OrganizedEventsSection from '../components/OrganizedEventsSection.astro';
import { getEntry, getCollection, render } from 'astro:content';

const site = await getEntry('site', 'info');
if (!site) throw new Error('Missing site/info data entry');

const bio = await getEntry('bio', 'main');
if (!bio) throw new Error('Missing bio/main content entry');
const { Content: BioContent } = await render(bio);

const news = await getCollection('news');
const publications = await getCollection('publications');
const talks = await getCollection('talks');
const organizedEvents = await getCollection('organized_events');
const projects = site.data.project_memberships ?? [];

type SectionId = 'about' | 'publications' | 'projects' | 'talks' | 'news' | 'organized_events';

// Zod gives us defaults, but keep a defensive fallback in case of unusual schema state.
const theme = site.data.theme ?? {
  palette: 'bianca' as const,
  show_photo: true,
  hero_name_size: 'default' as const,
  hidden_sections: ['news', 'organized_events'] as SectionId[],
  section_order: ['about', 'publications', 'projects', 'talks', 'news', 'organized_events'] as SectionId[],
};

const hidden = new Set<string>(theme.hidden_sections);

const hasContent: Record<SectionId, boolean> = {
  about: true,
  publications: publications.length > 0,
  projects: projects.length > 0,
  talks: talks.length > 0,
  news: news.length > 0,
  organized_events: organizedEvents.length > 0,
};

const navLabels: Record<SectionId, string> = {
  about: 'About',
  publications: 'Research',
  projects: 'Projects',
  talks: 'Talks',
  news: 'News',
  organized_events: 'Events',
};

// DOM anchor ids (publications renders as the "Research" bibliography).
const anchorIds: Record<SectionId, string> = {
  about: 'about',
  publications: 'research',
  projects: 'projects',
  talks: 'talks',
  news: 'news',
  organized_events: 'organized-events',
};

const visibleSections: SectionId[] = (theme.section_order as SectionId[]).filter(
  (id) => !hidden.has(id) && hasContent[id]
);

const navItems = visibleSections.map((id) => ({ id: anchorIds[id], label: navLabels[id] }));

const social = {
  email: site.data.email,
  orcid_url: site.data.orcid_url,
  scholar_url: site.data.scholar_url,
  philpeople_url: site.data.philpeople_url,
  academia_url: site.data.academia_url,
  github_url: site.data.github_url,
};

const htmlClass = [
  theme.palette !== 'bianca' && `palette-${theme.palette}`,
  theme.hero_name_size !== 'default' && `hero-name-${theme.hero_name_size}`,
]
  .filter(Boolean)
  .join(' ');
---

<Layout
  title={`${site.data.name} — ${site.data.role}`}
  description={site.data.tagline}
  htmlClass={htmlClass}
>
  <Masthead
    name={site.data.name}
    subtitle={`${site.data.role} · ${site.data.affiliation}`}
    items={navItems}
  />

  <main>
    {visibleSections.map((id) => {
      if (id === 'about') return (
        <About
          name={site.data.name}
          photo={site.data.photo}
          photo_credit={site.data.photo_credit}
          show_photo={theme.show_photo}
          social={social}
          cv_pdf={site.data.cv_pdf}
          affiliations={site.data.affiliations}
          education={site.data.education}
          editorial_roles={site.data.editorial_roles}
          memberships={site.data.memberships}
          peer_review_for={site.data.peer_review_for}
        >
          <BioContent />
        </About>
      );
      if (id === 'publications') return <PublicationsSection />;
      if (id === 'projects') return <ProjectsSection projects={projects} />;
      if (id === 'talks') return <TalksSection />;
      if (id === 'news') return <NewsSection />;
      if (id === 'organized_events') return <OrganizedEventsSection />;
      return null;
    })}
  </main>
</Layout>
