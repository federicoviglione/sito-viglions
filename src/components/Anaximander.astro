---
// Anaximander — mini Asteroids easter-egg, vector-clean editorial style.
// Always running once the 404 page is mounted; aria-hidden for AT users.
---

<div class="anaximander" aria-hidden="true">
  <div class="anaximander-stage">
    <canvas class="anaximander-canvas" width="720" height="450"></canvas>
    <div class="anaximander-hud" aria-live="off">
      <span class="hud-label">velocity</span>
      <span class="hud-velocity" data-velocity>0.000c</span>
      <span class="hud-label">wave</span>
      <span class="hud-wave" data-wave>1</span>
    </div>
    <div class="anaximander-overlay" data-overlay hidden>
      <p class="overlay-title" data-overlay-title>Drift over.</p>
      <p class="overlay-sub" data-overlay-sub>—</p>
      <div class="overlay-actions">
        <button type="button" data-action="restart">Restart</button>
      </div>
    </div>
    <div class="anaximander-pause" data-pause hidden>Paused — press P or tap</div>
    <div class="anaximander-touch" data-touch hidden>
      <div class="touch-left">
        <button type="button" class="touch-btn" data-touch-action="rot-left" aria-label="Rotate left">↺</button>
        <button type="button" class="touch-btn" data-touch-action="rot-right" aria-label="Rotate right">↻</button>
      </div>
      <div class="touch-right">
        <button type="button" class="touch-btn touch-btn--big" data-touch-action="thrust" aria-label="Thrust">▲</button>
        <button type="button" class="touch-btn" data-touch-action="fire" aria-label="Fire">●</button>
      </div>
      <div class="touch-top">
        <button type="button" class="touch-btn touch-btn--small" data-touch-action="pause" aria-label="Pause">‖</button>
      </div>
    </div>
  </div>
</div>

<style>
  .anaximander {
    display: block;
    position: relative;
    margin-block: var(--space-5);
  }
  .anaximander-canvas {
    display: block;
    width: min(100%, 720px);
    aspect-ratio: 16 / 10;
    background: var(--ink);
    border: 1px solid var(--rule);
    touch-action: none;
  }
  .anaximander-stage {
    position: relative;
    width: min(100%, 720px);
  }
  .anaximander-stage .anaximander-canvas {
    width: 100%;
  }
  @media (max-width: 600px) and (orientation: portrait) {
    .anaximander-canvas {
      aspect-ratio: 3 / 4;
      width: min(100%, 480px);
    }
    .anaximander-stage {
      width: 100%;
    }
  }
  .anaximander-hud {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    right: var(--space-3);
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    pointer-events: none;
    mix-blend-mode: difference;
  }
  .hud-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.7;
  }
  .hud-velocity, .hud-wave {
    font-variant-numeric: tabular-nums;
  }

  .anaximander-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    background: rgba(21, 23, 26, 0.78);
    color: var(--paper);
    text-align: center;
    padding: var(--space-5);
  }
  .anaximander-overlay[hidden] { display: none; }
  .overlay-title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .overlay-sub {
    font-size: var(--fs-sm);
    opacity: 0.75;
  }
  .overlay-actions { display: flex; gap: var(--space-3); }
  .overlay-actions button {
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--paper);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }
  .overlay-actions button:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .overlay-actions button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .anaximander-pause {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    background: rgba(21, 23, 26, 0.55);
  }
  .anaximander-pause[hidden] { display: none; }

  .anaximander-touch {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .anaximander-touch[hidden] { display: none; }
  .anaximander-touch .touch-left,
  .anaximander-touch .touch-right,
  .anaximander-touch .touch-top {
    position: absolute;
    display: flex;
    gap: var(--space-3);
    pointer-events: auto;
  }
  .anaximander-touch .touch-left {
    left: var(--space-3);
    bottom: var(--space-3);
  }
  .anaximander-touch .touch-right {
    right: var(--space-3);
    bottom: var(--space-3);
    align-items: flex-end;
  }
  .anaximander-touch .touch-top {
    top: var(--space-3);
    right: var(--space-3);
    gap: var(--space-2);
  }
  .touch-btn {
    width: 56px;
    height: 56px;
    border: 1px solid var(--paper);
    background: rgba(21, 23, 26, 0.45);
    color: var(--paper);
    font-size: 20px;
    font-family: var(--font-body);
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 100ms ease;
  }
  .touch-btn:active,
  .touch-btn[data-active="1"] {
    background: rgba(246, 246, 244, 0.25);
  }
  .touch-btn--big {
    width: 72px;
    height: 72px;
    font-size: 26px;
  }
  .touch-btn--small {
    width: 36px;
    height: 36px;
    font-size: 14px;
    border-radius: 50%;
  }
  /* Visibility is controlled in JS by toggling [hidden]; CSS only styles. */
</style>

<script>
  const root = document.querySelector<HTMLDivElement>('.anaximander');
  const canvas = document.querySelector<HTMLCanvasElement>('.anaximander-canvas');
  if (!root || !canvas) {
    // No-op: canvas non disponibile o componente non montato.
  } else {
    const ctx = canvas.getContext('2d');
    if (!ctx) {
      console.warn('[anaximander] canvas 2d context not available');
    } else {
      // -------- Game state --------
      type Ship = { x: number; y: number; vx: number; vy: number; angle: number; alive?: boolean };
      let ship: Ship = { x: 0, y: 0, vx: 0, vy: 0, angle: -Math.PI / 2, alive: true };
      let running = false;
      let lastT = 0;
      let rafId = 0;
      let canvasW = 0;
      let canvasH = 0;
      let deathTimer = 0;
      let paused = false;
      let gameOver = false;
      const elOverlay = root.querySelector<HTMLElement>('[data-overlay]');
      const elOverlaySub = root.querySelector<HTMLElement>('[data-overlay-sub]');
      const elPause = root.querySelector<HTMLElement>('[data-pause]');
      const elRestart = root.querySelector<HTMLButtonElement>('[data-action="restart"]');
      const elTouch = root.querySelector<HTMLElement>('[data-touch]');
      const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

      const touchHold: Record<string, Set<number>> = {
        'rot-left': new Set(),
        'rot-right': new Set(),
        'thrust': new Set(),
        'fire': new Set(),
      };

      function touchActive(action: string): boolean {
        return (touchHold[action]?.size ?? 0) > 0;
      }

      // -------- Utilities --------
      function wrap(v: number, max: number): number {
        if (v < 0) return v + max;
        if (v >= max) return v - max;
        return v;
      }

      // Dev-only micro-asserts (run once at module load in dev mode).
      if (import.meta.env.DEV) {
        console.assert(wrap(5, 10) === 5, 'wrap inside');
        console.assert(wrap(-1, 10) === 9, 'wrap negative');
        console.assert(wrap(11, 10) === 1, 'wrap over');
      }

      function circleHit(ax: number, ay: number, ar: number, bx: number, by: number, br: number): boolean {
        const dx = ax - bx, dy = ay - by;
        return dx * dx + dy * dy <= (ar + br) * (ar + br);
      }

      if (import.meta.env.DEV) {
        console.assert(circleHit(0, 0, 5, 3, 0, 5) === true, 'circleHit overlap');
        console.assert(circleHit(0, 0, 1, 100, 0, 1) === false, 'circleHit far');
        console.assert(circleHit(0, 0, 1, 2, 0, 1) === true, 'circleHit touch');
      }

      const keys = new Set<string>();

      type Bullet = { x: number; y: number; vx: number; vy: number; life: number };
      const bullets: Bullet[] = [];
      let fireCooldown = 0;
      const BULLET_SPEED = 500; // px/sec
      const BULLET_LIFE = 0.8;  // sec
      const FIRE_COOLDOWN = 0.15; // sec

      type RockSize = 'L' | 'M' | 'S';
      type Rock = {
        x: number; y: number;
        vx: number; vy: number;
        angle: number; va: number; // angular vel
        size: RockSize;
        radius: number;
        shape: number[]; // polygon offsets per vertex (relative to radius)
      };
      const rocks: Rock[] = [];
      let wave = 1;

      // -------- Velocity (relativistic display) --------
      // C_PIXELS = THRUST * 1000 so that one second of thrust raises v by 0.001c.
      const C_PIXELS = 200_000;
      const MAXV_KEY = 'anaximander.maxv';
      let maxV = 0;
      let bestV = 0;
      try { bestV = parseFloat(localStorage.getItem(MAXV_KEY) || '0') || 0; } catch {}

      function formatC(v: number): string {
        return (v / C_PIXELS).toFixed(3) + 'c';
      }

      const elVelocity = root.querySelector<HTMLElement>('[data-velocity]');
      const elWave = root.querySelector<HTMLElement>('[data-wave]');

      function syncHud() {
        if (elVelocity) {
          const speed = Math.hypot(ship.vx, ship.vy);
          elVelocity.textContent = formatC(speed);
        }
        if (elWave) elWave.textContent = String(wave);
      }

      const ROCK_RADIUS: Record<RockSize, number> = { L: 38, M: 22, S: 12 };
      const ROCK_SPEED: Record<RockSize, number> = { L: 35, M: 55, S: 80 };

      function randRange(a: number, b: number) {
        return a + Math.random() * (b - a);
      }

      function makeRockShape(): number[] {
        const verts = 10;
        const out: number[] = [];
        for (let i = 0; i < verts; i++) {
          out.push(0.78 + Math.random() * 0.37);
        }
        return out;
      }

      function makeRock(x: number, y: number, size: RockSize, speedMul = 1): Rock {
        const dir = Math.random() * Math.PI * 2;
        const sp = ROCK_SPEED[size] * speedMul;
        return {
          x, y,
          vx: Math.cos(dir) * sp,
          vy: Math.sin(dir) * sp,
          angle: Math.random() * Math.PI * 2,
          va: randRange(-1.2, 1.2),
          size,
          radius: ROCK_RADIUS[size],
          shape: makeRockShape(),
        };
      }

      function splitRock(r: Rock): Rock[] {
        if (r.size === 'L') return [makeRock(r.x, r.y, 'M'), makeRock(r.x, r.y, 'M')];
        if (r.size === 'M') return [makeRock(r.x, r.y, 'S'), makeRock(r.x, r.y, 'S')];
        return [];
      }

      function spawnWave(n: number, speedMul: number) {
        rocks.length = 0;
        for (let i = 0; i < n; i++) {
          const onTop = Math.random() < 0.5;
          const x = onTop
            ? Math.random() * canvasW
            : (Math.random() < 0.5 ? 0 : canvasW - 1);
          const y = onTop
            ? (Math.random() < 0.5 ? 0 : canvasH - 1)
            : Math.random() * canvasH;
          rocks.push(makeRock(x, y, 'L', speedMul));
        }
      }

      function onKeyDown(e: KeyboardEvent) {
        if (!running) return;
        const k = e.key;
        if (['ArrowLeft', 'ArrowRight', 'ArrowUp', ' '].includes(k)) {
          e.preventDefault();
        }
        if (k === 'Escape' || k === 'p' || k === 'P') {
          e.preventDefault();
          togglePause();
          return;
        }
        keys.add(k);
      }
      function onKeyUp(e: KeyboardEvent) {
        keys.delete(e.key);
      }

      // -------- Canvas sizing --------
      function resize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas.getBoundingClientRect();
        const w = Math.floor(rect.width);
        const h = Math.floor(rect.height);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // If we had prior dimensions and they changed, rescale entities to preserve relative positions
        if (canvasW > 0 && canvasH > 0 && (canvasW !== w || canvasH !== h)) {
          const sx = w / canvasW;
          const sy = h / canvasH;
          ship.x *= sx; ship.y *= sy;
          ship.vx *= sx; ship.vy *= sy;
          for (const b of bullets) {
            b.x *= sx; b.y *= sy;
            b.vx *= sx; b.vy *= sy;
          }
          for (const r of rocks) {
            r.x *= sx; r.y *= sy;
            r.vx *= sx; r.vy *= sy;
          }
        } else if (!running) {
          ship.x = w / 2;
          ship.y = h / 2;
        }

        canvasW = w;
        canvasH = h;
      }

      // -------- Drawing --------
      function drawShip(s: Ship) {
        ctx.save();
        ctx.translate(s.x, s.y);
        ctx.rotate(s.angle);
        ctx.strokeStyle = '#f6f6f4'; // --paper
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(12, 0);
        ctx.lineTo(-8, 7);
        ctx.lineTo(-5, 0);
        ctx.lineTo(-8, -7);
        ctx.closePath();
        ctx.stroke();
        ctx.restore();
      }

      function clear() {
        ctx.fillStyle = '#15171a';
        ctx.fillRect(0, 0, canvasW, canvasH);
      }

      // -------- Physics constants --------
      const ROT_SPEED = 3.5;     // rad/sec
      const THRUST = 200;        // px/sec^2  (= 0.001c per second of thrust)
      const RECOIL = 30;         // px/sec impulse per shot, opposite of fire direction

      function update(dt: number) {
        if (ship.alive === false && !gameOver) {
          deathTimer += dt;
          if (deathTimer > 1.2) {
            triggerGameOver();
          }
          return;
        }
        if (gameOver) return;

        if (keys.has('ArrowLeft') || touchActive('rot-left')) ship.angle -= ROT_SPEED * dt;
        if (keys.has('ArrowRight') || touchActive('rot-right')) ship.angle += ROT_SPEED * dt;
        if (keys.has('ArrowUp') || touchActive('thrust')) {
          ship.vx += Math.cos(ship.angle) * THRUST * dt;
          ship.vy += Math.sin(ship.angle) * THRUST * dt;
        }
        // Vacuum: no drag. Velocity persists until thrust or recoil changes it.
        ship.x = wrap(ship.x + ship.vx * dt, canvasW);
        ship.y = wrap(ship.y + ship.vy * dt, canvasH);

        // Track max velocity reached this run, and personal best.
        const speedNow = Math.hypot(ship.vx, ship.vy);
        if (speedNow > maxV) {
          maxV = speedNow;
          if (maxV > bestV) {
            bestV = maxV;
            try { localStorage.setItem(MAXV_KEY, String(bestV)); } catch {}
          }
        }

        // Fire
        fireCooldown = Math.max(0, fireCooldown - dt);
        if ((keys.has(' ') || touchActive('fire')) && fireCooldown === 0) {
          bullets.push({
            x: ship.x + Math.cos(ship.angle) * 12,
            y: ship.y + Math.sin(ship.angle) * 12,
            vx: Math.cos(ship.angle) * BULLET_SPEED + ship.vx,
            vy: Math.sin(ship.angle) * BULLET_SPEED + ship.vy,
            life: BULLET_LIFE,
          });
          // Recoil: each shot pushes the ship backwards along its current heading.
          ship.vx -= Math.cos(ship.angle) * RECOIL;
          ship.vy -= Math.sin(ship.angle) * RECOIL;
          fireCooldown = FIRE_COOLDOWN;
        }

        // Bullets update
        for (let i = bullets.length - 1; i >= 0; i--) {
          const b = bullets[i];
          b.life -= dt;
          if (b.life <= 0) {
            bullets.splice(i, 1);
            continue;
          }
          b.x = wrap(b.x + b.vx * dt, canvasW);
          b.y = wrap(b.y + b.vy * dt, canvasH);
        }

        // Rocks update
        for (const r of rocks) {
          r.x = wrap(r.x + r.vx * dt, canvasW);
          r.y = wrap(r.y + r.vy * dt, canvasH);
          r.angle += r.va * dt;
        }

        // Bullet -> Rock collisions
        for (let i = bullets.length - 1; i >= 0; i--) {
          const b = bullets[i];
          for (let j = rocks.length - 1; j >= 0; j--) {
            const r = rocks[j];
            if (circleHit(b.x, b.y, 2, r.x, r.y, r.radius)) {
              bullets.splice(i, 1);
              const fragments = splitRock(r);
              rocks.splice(j, 1, ...fragments);
              break;
            }
          }
        }

        // Ship -> Rock collisions
        if (ship.alive !== false) {
          for (const r of rocks) {
            if (circleHit(ship.x, ship.y, 6, r.x, r.y, r.radius)) {
              ship.alive = false;
              break;
            }
          }
        }

        // Wave clear?
        if (rocks.length === 0 && ship.alive !== false) {
          wave += 1;
          const speedMul = Math.min(1 + 0.05 * (wave - 1), 2);
          spawnWave(2 + wave, speedMul);
        }
      }

      function drawBullets() {
        ctx.fillStyle = '#f6f6f4';
        for (const b of bullets) {
          ctx.beginPath();
          ctx.arc(b.x, b.y, 1.5, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function drawRocks() {
        ctx.strokeStyle = '#f6f6f4';
        ctx.lineWidth = 1.25;
        for (const r of rocks) {
          ctx.save();
          ctx.translate(r.x, r.y);
          ctx.rotate(r.angle);
          ctx.beginPath();
          const verts = r.shape.length;
          for (let i = 0; i < verts; i++) {
            const a = (i / verts) * Math.PI * 2;
            const rad = r.radius * r.shape[i];
            const x = Math.cos(a) * rad;
            const y = Math.sin(a) * rad;
            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.closePath();
          ctx.stroke();
          ctx.restore();
        }
      }

      function frame(t: number) {
        if (!running) return;
        if (paused) return;
        const dt = Math.min((t - lastT) / 1000, 0.05);
        lastT = t;
        update(dt);
        syncHud();
        clear();
        drawBullets();
        drawRocks();
        if (ship.alive !== false) drawShip(ship);
        if (!gameOver) {
          rafId = requestAnimationFrame(frame);
        }
      }

      function start() {
        if (running) return;
        ship = { x: 0, y: 0, vx: 0, vy: 0, angle: -Math.PI / 2, alive: true };
        bullets.length = 0;
        wave = 1;
        maxV = 0;
        deathTimer = 0;
        resize();
        ship.x = canvasW / 2;
        ship.y = canvasH / 2;
        spawnWave(3, 1);
        syncHud();
        running = true;
        if (elTouch && isTouchDevice) elTouch.hidden = false;
        lastT = performance.now();
        rafId = requestAnimationFrame(frame);
      }

      function triggerGameOver() {
        gameOver = true;
        if (elOverlay) {
          elOverlay.hidden = false;
          if (elOverlaySub) {
            elOverlaySub.textContent = `Top speed: ${formatC(maxV)}. Personal best: ${formatC(bestV)}.`;
          }
          elRestart?.focus();
        }
      }

      function clearInputState() {
        keys.clear();
        for (const set of Object.values(touchHold)) set.clear();
        fireCooldown = 0;
      }

      function restart() {
        clearInputState();
        gameOver = false;
        if (elOverlay) elOverlay.hidden = true;
        ship = { x: canvasW / 2, y: canvasH / 2, vx: 0, vy: 0, angle: -Math.PI / 2, alive: true };
        bullets.length = 0;
        wave = 1;
        maxV = 0;
        deathTimer = 0;
        spawnWave(3, 1);
        syncHud();
        // Re-prime the loop in case rAF was not pending
        if (running) {
          lastT = performance.now();
          rafId = requestAnimationFrame(frame);
        }
      }

      function togglePause() {
        if (!running || gameOver) return;
        paused = !paused;
        if (elPause) elPause.hidden = !paused;
        if (!paused) {
          lastT = performance.now();
          rafId = requestAnimationFrame(frame);
        }
      }

      // -------- Events --------
      window.addEventListener('resize', () => {
        if (running) resize();
      });

      window.addEventListener('orientationchange', () => {
        if (running) setTimeout(resize, 50);
      });

      window.addEventListener('keydown', onKeyDown);
      window.addEventListener('keyup', onKeyUp);

      elRestart?.addEventListener('click', restart);
      elPause?.addEventListener('click', togglePause);

      const touchButtons = root.querySelectorAll<HTMLButtonElement>('.touch-btn');
      touchButtons.forEach((btn) => {
        const action = btn.dataset.touchAction;
        if (!action) return;

        const setVisualActive = (on: boolean) => {
          btn.setAttribute('data-active', on ? '1' : '0');
        };

        btn.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          if (action === 'pause') { togglePause(); return; }
          btn.setPointerCapture(e.pointerId);
          touchHold[action]?.add(e.pointerId);
          setVisualActive(true);
        });

        const release = (e: PointerEvent) => {
          touchHold[action]?.delete(e.pointerId);
          if (!touchActive(action)) setVisualActive(false);
        };
        btn.addEventListener('pointerup', release);
        btn.addEventListener('pointercancel', release);
      });

      // Auto-start: the game is always visible on /404, no click required.
      start();
    }
  }
</script>
