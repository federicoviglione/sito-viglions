---
interface Affiliation { period: string; role: string; institution: string; location?: string; current?: boolean; }
interface Education { period: string; degree: string; institution: string; location?: string; thesis_title?: string; supervisors?: string; grade?: string; }
interface EditorialRole { journal: string; role: string; url?: string; }
interface Membership { name: string; role?: string; period?: string; url?: string; }
interface SocialLinks {
  email: string;
  orcid_url?: string;
  scholar_url?: string;
  philpeople_url?: string;
  academia_url?: string;
  github_url?: string;
}

interface Props {
  name: string;
  photo?: string;
  photo_credit?: string;
  show_photo?: boolean;
  social: SocialLinks;
  cv_pdf?: string;
  affiliations?: Affiliation[];
  education?: Education[];
  editorial_roles?: EditorialRole[];
  memberships?: Membership[];
  peer_review_for?: string[];
  hidden_blocks?: string[];
}

const {
  name, photo, photo_credit, show_photo = true, social, cv_pdf,
  affiliations, education, editorial_roles, memberships, peer_review_for,
  hidden_blocks = [],
} = Astro.props;

// Editor-controlled: a block listed here keeps its content in the CMS but
// stops rendering, so hiding it is reversible.
const hidden = new Set(hidden_blocks);
const shown = <T,>(block: string, items?: T[]): items is T[] =>
  !hidden.has(block) && !!items && items.length > 0;

const hasPhoto = show_photo && !!photo;

const profileLinks = [
  social.orcid_url && { label: 'ORCID', href: social.orcid_url },
  social.scholar_url && { label: 'Google Scholar', href: social.scholar_url },
  social.philpeople_url && { label: 'PhilPeople', href: social.philpeople_url },
  social.academia_url && { label: 'Academia.edu', href: social.academia_url },
  social.github_url && { label: 'GitHub', href: social.github_url },
].filter(Boolean) as Array<{ label: string; href: string }>;
---

<section id="about" class="about page">
  <div class="about-grid">
    {hasPhoto && (
      <figure class="portrait">
        <img src={photo} alt={`Portrait of ${name}`} width={300} height={375} loading="eager" />
        {photo_credit && <figcaption>{photo_credit}</figcaption>}
      </figure>
    )}
    <div class="bio">
      <div class="bio-prose">
        <slot />
      </div>
      <div class="contact-row">
        <p class="email">Email: <a href={`mailto:${social.email}`}>{social.email}</a></p>
        {cv_pdf && <a class="cv-button" href={cv_pdf} target="_blank" rel="noopener noreferrer">Download CV</a>}
      </div>
      {profileLinks.length > 0 && (
        <ul class="profiles">
          {profileLinks.map(l => (
            <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>

  {shown('affiliations', affiliations) && (
    <div class="facts">
      <div class="group-label">Academic positions</div>
      <ul>
        {affiliations.map(a => (
          <li>
            <span class="period">{a.period}</span>
            {a.role}, {a.institution}{a.location ? `, ${a.location}` : ''}
          </li>
        ))}
      </ul>
    </div>
  )}

  {shown('education', education) && (
    <div class="facts">
      <div class="group-label">Education</div>
      <ul>
        {education.map(e => (
          <li>
            <span class="period">{e.period}</span>
            {e.degree}, {e.institution}{e.location ? `, ${e.location}` : ''}
            {e.thesis_title && <div class="thesis"><em>“{e.thesis_title}”</em>{e.supervisors ? ` — Supervisors: ${e.supervisors}` : ''}{e.grade ? ` (${e.grade})` : ''}</div>}
          </li>
        ))}
      </ul>
    </div>
  )}

  {shown('editorial_roles', editorial_roles) && (
    <div class="facts">
      <div class="group-label">Editorial roles</div>
      <ul>
        {editorial_roles.map(r => (
          <li>{r.role}, {r.url ? <a href={r.url} target="_blank" rel="noopener noreferrer"><em>{r.journal}</em></a> : <em>{r.journal}</em>}</li>
        ))}
      </ul>
    </div>
  )}

  {shown('memberships', memberships) && (
    <div class="facts">
      <div class="group-label">Memberships</div>
      <ul>
        {memberships.map(m => (
          <li>
            {m.period && <span class="period">{m.period}</span>}
            {m.url ? <a href={m.url} target="_blank" rel="noopener noreferrer">{m.name}</a> : m.name}
            {m.role ? `, ${m.role}` : ''}
          </li>
        ))}
      </ul>
    </div>
  )}

  {shown('peer_review', peer_review_for) && (
    <div class="facts">
      <div class="group-label">Peer review</div>
      <p class="peer-review">Reviewer for {peer_review_for.map((j, i) => (<><em>{j}</em>{i < peer_review_for.length - 1 ? ', ' : '.'}</>))}</p>
    </div>
  )}
</section>

<style>
  .about { padding-block: var(--space-5) var(--space-6); }

  /* flow-root keeps the floated portrait inside this box, so it can never
     overlap the fact blocks below. */
  .about-grid { display: flow-root; }

  .portrait {
    float: left;
    margin: 5px var(--space-6) var(--space-4) 0;
  }
  .portrait img {
    width: 300px;
    height: 375px;
    object-fit: cover;
    /* Bias the crop upwards: in portraits the face sits above centre. */
    object-position: center 30%;
    border: 1px solid var(--rule);
  }
  .portrait figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  /* Plain blocks, not flex: a flex container would sit beside the float
     instead of letting the text wrap under the portrait. */
  .bio-prose {
    font-family: var(--font-serif);
    font-size: var(--fs-serif);
    line-height: 1.7;
    color: var(--ink);
  }
  .bio-prose :global(p) { margin-bottom: var(--space-4); }
  .bio-prose :global(p:last-child) { margin-bottom: 0; }
  .bio-prose :global(a) { color: var(--accent); border-bottom: 1px solid var(--accent-soft); }
  .bio-prose :global(a:hover) { color: var(--ink); border-color: var(--ink); }
  /* An image pasted into the bio text (rather than the Photo field) still has
     to behave: keep it inside the column instead of blowing up full-bleed. */
  .bio-prose :global(img) {
    max-width: min(260px, 100%);
    height: auto;
    margin-block: var(--space-4);
    border: 1px solid var(--rule);
  }

  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    /* Being a flex container it cannot wrap around the float, so drop it
       below the portrait rather than squeezing it into the leftover width. */
    clear: left;
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .email { font-size: var(--fs-base); color: var(--muted); }
  .email a { color: var(--accent); }
  .email a:hover { color: var(--ink); }
  .cv-button {
    display: inline-block;
    background: var(--accent);
    color: var(--paper);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 4px;
  }
  .cv-button:hover { background: var(--ink); color: var(--paper); }

  .profiles {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    clear: left;
    gap: var(--space-2) var(--space-4);
    font-size: var(--fs-sm);
  }
  .profiles a { color: var(--accent); border-bottom: 1px solid var(--accent-soft); padding-bottom: 1px; }
  .profiles a:hover { color: var(--ink); border-color: var(--ink); }

  .facts { margin-top: var(--space-5); }
  .facts .group-label { margin-bottom: var(--space-2); }
  .facts ul { list-style: none; font-size: var(--fs-sm); line-height: 1.6; }
  .facts li { margin-bottom: var(--space-2); }
  .facts li:last-child { margin-bottom: 0; }
  .facts em { color: var(--muted); }
  .facts .period { color: var(--muted); font-family: var(--font-mono); font-size: 12px; margin-right: var(--space-2); }
  .facts .thesis { color: var(--muted); }
  .facts a { color: var(--accent); }
  .peer-review { font-size: var(--fs-sm); }

  /* Too narrow to wrap text beside the portrait: stack it above the bio,
     full width so its edges line up with the text. */
  @media (max-width: 600px) {
    .portrait {
      float: none;
      margin: 0 0 var(--space-5);
    }
    .portrait img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }
</style>
