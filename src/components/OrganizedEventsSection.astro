---
import { getCollection } from 'astro:content';

const all = await getCollection('organized_events');
const sorted = all.sort((a, b) => (b.data.start_date as Date).getTime() - (a.data.start_date as Date).getTime());

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

function roleLabel(role: string) {
  return role.replace(/-/g, ' ');
}
---
{sorted.length > 0 && (
  <section id="organized-events" class="events page section">
    <h2 class="section-title">Organized events</h2>
    <div class="list">
      {sorted.map(e => (
        <div class="item">
          <span class="date">{fmtDate(e.data.start_date as Date)}</span>
          <span class="body">
            <span class="title">
              {e.data.url ? <a href={e.data.url} target="_blank" rel="noopener noreferrer">{e.data.title}</a> : e.data.title}
            </span>
            <span class="meta"> — <span class="role">{roleLabel(e.data.role)}</span> · {e.data.venue}{e.data.location ? `, ${e.data.location}` : ''}</span>
          </span>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .list { display: flex; flex-direction: column; gap: var(--space-3); }
  .item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: var(--space-4);
    align-items: baseline;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .title { font-family: var(--font-serif); font-size: var(--fs-bib); color: var(--ink); }
  .title a { color: var(--ink); border-bottom: 1px solid var(--rule); }
  .title a:hover { color: var(--accent); border-color: var(--accent-soft); }
  .meta { color: var(--muted); font-size: var(--fs-sm); }
  .role { text-transform: capitalize; }

  @media (max-width: 480px) {
    .item { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
