---
import { getCollection, getEntry } from 'astro:content';

const all = await getCollection('talks');
const sorted = all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime());

const site = await getEntry('site', 'info');
const bySlug = new Map(sorted.map(t => [t.slug, t]));

// Editor-curated list from the CMS; unknown slugs (renamed or deleted talks) are
// dropped, and an empty selection falls back to the three most recent talks.
const curated = (site?.data.selected_talks ?? [])
  .map(slug => bySlug.get(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
const selected = curated.length > 0 ? curated : sorted.slice(0, 3);

const hasMore = sorted.length > selected.length;

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---
{sorted.length > 0 && (
  <section id="talks" class="talks page section">
    <h2 class="section-title">Selected talks</h2>
    <div class="list">
      {selected.map(t => (
        <div class="talk">
          <span class="date">{fmtDate(t.data.date as Date)}</span>
          <span class="body">
            <span class="title">
              {t.data.url ? <a href={t.data.url} target="_blank" rel="noopener noreferrer">{t.data.title}</a> : t.data.title}
            </span>
            <span class="venue"> — {t.data.venue}{t.data.location ? `, ${t.data.location}` : ''}</span>
          </span>
        </div>
      ))}
    </div>
    {hasMore && <a class="more" href="/talks/">More talks →</a>}
  </section>
)}

<style>
  .list { display: flex; flex-direction: column; gap: var(--space-3); }
  .talk {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: var(--space-4);
    align-items: baseline;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .title { font-family: var(--font-serif); font-size: var(--fs-bib); color: var(--ink); }
  .title a { color: var(--ink); border-bottom: 1px solid var(--rule); }
  .title a:hover { color: var(--accent); border-color: var(--accent-soft); }
  .venue { color: var(--muted); font-size: var(--fs-sm); }
  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
  }
  .more:hover { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 480px) {
    .talk { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
